{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && yarn install --frozen-lockfile",
  "buildCommand": "cd frontend && CI=false yarn build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/soporte",
      "destination": "/soporte.html"
    },
    {
      "source": "/((?!static/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
